{
  "manifest_version": 3,
  "name": "AI Usage Counter",
  "version": "0.6.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "{236c6889-52b6-4454-bc4b-5a2ad18effa2}",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "description": "Shows ~token count, cache timer, and usage bars on claude.ai, plus estimated 5-hour and weekly usage bars on gemini.google.com.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "action": {
    "default_title": "AI Usage Counter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "css": ["src/styles.css"],
      "js": [
        "src/content/constants.js",
        "src/content/bridge-client.js",
        "src/vendor/o200k_base.js",
        "src/content/tokens.js",
        "src/content/ui.js",
        "src/content/main.js"
      ]
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["src/styles.css"],
      "run_at": "document_start",
      "js": [
        "src/gemini/constants.js",
        "src/gemini/bridge-client.js",
        "src/gemini/estimator.js",
        "src/gemini/ui.js",
        "src/gemini/main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected/bridge.js"],
      "matches": ["https://claude.ai/*"]
    },
    {
      "resources": ["src/gemini/injected/bridge.js"],
      "matches": ["https://gemini.google.com/*"]
    }
  ]
}
